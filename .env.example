DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google sign-in. Only existing users can sign in (no public signup).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional SMTP for low-stock emails and scheduled reports.
# If missing, in-app low-stock alerts still work; reports will not send.
# CRON_SECRET=generate-a-long-random-string

# Optional AI (Fill from photo + Suggest category). Restart after setting.
# XAI_API_KEY=
# XAI_VISION_MODEL=grok-4.6
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM="PUB Inventory <inventory@powerupboston.com>"
